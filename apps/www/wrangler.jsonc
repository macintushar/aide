{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dashboard Worker name must match. Connect Git with root directory apps/www.
  "name": "aide-www",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
